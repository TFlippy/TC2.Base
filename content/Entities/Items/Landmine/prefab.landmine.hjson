$name: "Landmine"
$desc:
	'''
	Small deployable explosive that detonates upon contact.
	'''
$tags: []

body:
{
	@shape.line:
	{
		material: metal
		miss_chance: 0.142
		flags: none
		tags: none
		
		layer: entity, solid
		mask: world, item, creature
		exclude: tree
		
		mass: 3.600
		radius: 0.300
		friction: 0.700
		elasticity: 0.020
		
		rigidity_dynamic: 0.010
		cog_offset: [0.000, 0.125]
		
		a: [-0.200, 0.000]
		b: [0.200, 0.000]
		offset: [0.000, 0.125]
	}
}

health:
{
	max: 1000.000
}

holdable:
{
	offset: [0.000, 0.000]
	flags: storable
}

animated.renderer:
{
	sprite:
	{
		texture: landmine
		size: [8, 8]
	}
}

transform:
{

}

explosive:
{
	radius: 6.000
	power: 2.700
	damage_entity: 5200.000
	damage_terrain: 4000.000
	health_threshold: 0.900
	
	damage_type: explosion
	damage_type_secondary: shrapnel
	flags: explode_when_primed
	
	detonate_damage_filter: bullet_lc, bullet_hc, bullet_mg, bullet_ac, bullet_sg, bullet_kn, bullet_hw, bullet_musket, rivet, impact, crush, axe, pickaxe, shovel, club, blunt, sledgehammer, explosion, punch, ram, electricity, fracture, corrosion, stress, phlogiston, compression, mercury
	
	force_multiplier: 0.900
	
	smoke_amount: 1.300
	smoke_lifetime_multiplier: 0.700
	smoke_velocity_multiplier: 2.000
	
	flash_duration_multiplier: 0.150
	flash_intensity_multiplier: 0.200
	
	sparks_amount: 5.000
	
	volume: 1.100
	pitch: 0.800
}

landmine:
{
	flags: none
	
	frame_default: 0
	frame_armed: 1
	h_sound_arm: item.adjust.03
	h_sound_trigger: click
	
	mass_min: 10.000
}

packable:
{

}

faction:
{

}

interactable:
{
	flags: once, no_tab
	priority: -1.500
}