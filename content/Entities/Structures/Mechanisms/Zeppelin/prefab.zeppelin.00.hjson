essence.container:
{
	stability: 1.000
	health_threshold: 0.500
	glow_modifier: 2.000
	flags: no_noise
	type: pellet_magazine
	emit_type: stressor

	@inventory1:
	{
		type: essence
		flags: standalone, ignore_mass, no_auto_pickup
		stack_size_multiplier: 0.500
		
		filter:
		{
			require: essence, small, pellet, solid
			exclude: gas
		}
		offset: [40.000, 16.000]
		
		resource:
		{
			material: pellet.motion
			quantity: 125.000
		}
	}

	@sound.emitter:
	{
		file: essence.emit.motion.loop.00
		offset: [11.250, 15.000]
		volume: 2.300
		pitch: 0.4500
		size: 20.000
		size_max_modifier: 8.000
		spread: 100.000
		doppler: 1.600
		priority: 0.900
	}

	@light:
	{
		offset: [0.000, -0.500]
		scale: [10.000, 5.000]
		intensity: 1.000
		texture: light.circle.04
		rotation: 0.000
	}
}

