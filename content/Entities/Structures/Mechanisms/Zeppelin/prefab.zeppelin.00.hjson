storage:
{
	@inventory8:
	{
		type: ammo
		flags: standalone, ignore_mass, no_auto_pickup, unlimited, faction, vertical
		stack_size_multiplier: 20.000
		
		filter:
		{
			exclude: gas
		}
		
		resources:
		[
			{
				material: ammo.mg.ap
				quantity: 400.000
			}
			{
				material: ammo.hw.kinetic
				quantity: 20.000
			}
			{
				material: ammo.ac.hv
				quantity: 400.000
			}
		]
	}
}

