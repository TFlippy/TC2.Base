+slot.skyhook|instance:
{
	joint.base:
	{
		offset_a: [0.000, 15.125]
		offset_b: [0.000, -3.125]
		z: 0.000
		max_force: 500000.000
		max_torque: 20000.000
		
		material_type: metal
		
		flags: no_stress, instant_attach, delete_on_detach
	}

	joint.rope:
	{
		distance: 8.000
	}

	rope.renderer:
	{
		texture: skyhook.00.cable
		thickness: 0.700
		scale: 6.000
		z: -400.000
	}

	+attached|child:
	{
		$prefab: "skyhook.00"
	}
}

+slot.front|instance:
{
	joint.base:
	{
		offset_a: [42.875, 21.500]
		attaching_distance_max: 4.000
		z: 75.000
		max_force: 400000.000
		max_torque: 80000.000
		material_type: metal
		flags: attachment, allow_dragging, control_write, facing_reset_rot, facing_reset_pos, force_facing, mirror_x, no_stress, instant_attach, delete_on_detach
	}

	joint.piston:
	{
		error_bias: 0.000
		max_bias: 8.000
		stiffness: 150000.000
		damping: 3000.000
		axis_force: 400000.000
		spring_max_bias: 8.000
		max_distance: 2.000
		rotation: 0.000
		stress_mult_axis: 1.000
	}

	joint.gear:
	{
		error_bias: 0.001
		max_bias: 5.000
		min: 0.000
		max: 0.000
	}

	attachment.slot:
	{
		name: "Mount (Front)"
		identifier: "front"

		flags: keyboard_write, mouse_write
		flags_editable: locked, disabled, hold, invert, cycle, keyboard_read, mouse_read, keyboard_write, mouse_write, offset, rotation, brake

		rank: 4.000
		gui_size: [112.000, 72.000]
		offset_bounds: [0.000, -0.250, 0.000, 0.500]
	}

	+attached|child:
	{
		$prefab: "bp.blesk.3"
	}
}

