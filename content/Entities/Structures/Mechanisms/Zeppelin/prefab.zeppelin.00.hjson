body:
{
	type: kinematic
	
	@shape.complex:
	{
		material: metal_sheet
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, solid, vehicle
		mask: solid
		exclude: world, bounds
		
		mass: 55000.000
		radius: 8.000
		friction: 0.950
		elasticity: 0.100
		
		cog_offset: [0.000, 0.000]
		
		count: 8
		points:
		[
			[-75.875, -3.875]
			[-16.500, -11.875]
			[41.000, -11.500]
			[74.500, -2.125]
			[74.500, 3.375]
			[65.375, 7.125]
			[-17.875, 8.625]
			[-60.750, 3.875]
		]
	}

	@shape.polygon:
	{
		material: metal
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, solid, vehicle
		mask: solid
		exclude: world, bounds, attached
		
		mass: 7500.000
		radius: 1.500
		friction: 0.950
		elasticity: 0.500
		
		cog_offset: [0.000, 0.000]
		
		points:
		[
			[42.000, 16.250]
			[67.250, 11.500]
			[65.125, 20.250]
			[42.375, 20.125]
		]
	}

	@shape.line:
	{
		material: metal
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, solid, vehicle
		mask: solid
		exclude: world, bounds, attached
		
		mass: 500.000
		radius: 0.500
		friction: 0.950
		elasticity: 0.500
		
		cog_offset: [0.000, 0.000]
		
		a: [34.250, 22.750]
		b: [42.625, 21.125]
		offset: [0.000, 0.000]
	}
}

