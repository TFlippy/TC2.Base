+slot|instance:
{
	joint.base:
	{
		offset_a: [0.000, 0.000]
		z: 0.000
		max_force: 500000.000
		max_torque: 20000.000
		
		material_type: none
		
		flags: no_stress, instant_attach, delete_on_detach
	}

	joint.rope:
	{
		distance: 32.000
	}

	rope.renderer:
	{
		texture: skyhook.00.cable
		thickness: 0.700
		scale: 6.000
		z: -400.000
	}

	+attached|child:
	{
		$prefab: "skyhook.00"
	}
}