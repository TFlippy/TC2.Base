minimap.marker:
{
	sprite:
	{
		texture: ui_icons_minimap
		size: [16, 16]
		frame: [0, 0]
	}
}

interactable:
{
	window_size: [592.000, 408.000]
	window_size_misc: [96.000, 0.000]
	priority: 10.000
}

lamp:
{
	flicker: 0.000
	blink_frequency: 1.000
	blink_amplitude: 0.500
	
	@light:
	{
		color: [1.000, 0.400, 0.000, 2.700]
		offset: [-1.000, -3.500]
		scale: [16.000, 16.000]
		texture: light.circle.04
	}
}

vehicle:
{

}

control:
{

}

controllable:
{
	
}

claw:
{
	sound_attach: "claw.attach.00"
	sound_detach: "claw.detach.00"
	frame_attached: 1
	frame_detached: 1
}

+slot.bottom|instance:
{
	joint.base:
	{
		offset_a: [0.000, 1.750]
		max_force: 850000.000
		max_torque: 150000.000
		max_stress: 3.000
		stress_threshold: 1.500
		stress_damp: 0.500
		z: -1000.000
		material_type: metal
		stress: 0.000
		flags: attachment, allow_dragging, control_read, control_write
	}

	joint.gear:
	{
		error_bias: 0.001
		max_bias: 5.000
		min: 0.000
		max: 0.000
		stress_mult: 0.500
	}

	// joint.piston:
	// {
	// 	error_bias: 0.000
	// 	max_bias: 4.000
	// 	stiffness: 40000.000
	// 	damping: 1250.000
	// 	axis_force: 800000.000
	// 	spring_max_bias: 4.000
	// 	max_distance: 1.500
	// 	rotation: 1.5707
	// 	stress_mult_axis: 1.000
	// }

	joint.pivot:
	{
		max_bias: 8.000
		error_bias: 0.001
	}

	attachment.slot:
	{
		name: "Mount (Bottom)"
		identifier: "bottom"

		flags: keyboard_write, mouse_write
		flags_editable: locked, disabled, hold, invert, cycle, keyboard_read, mouse_read, keyboard_write, mouse_write, offset, rotation, brake

		rank: 10.000
		gui_size: [224.000, 96.000]
		offset_bounds: [0.000, -1.000, 0.000, 0.500]
	}

	grabber:
	{
		offset: [0.000, 2.000]
		flags: can_attach
		radius: 2.000
	}
}
