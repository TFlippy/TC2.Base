$name: "Skyhook"
$desc: "TODO: Desc"

$tags: []

body:
{
	type: dynamic
	
	@shape.polygon:
	{
		material: metal
		miss_chance: 0.000
		flags: none
		tags: none
		
		layer: entity, solid
		mask: world
		exclude: none
		
		mass: 500.000
		radius: 0.750
		friction: 0.950
		elasticity: 0.500
		
		cog_offset: [0.000, 1.250]
		
		points:
		[
			[-0.625, -3.125]
			[0.375, -2.875]
			[1.000, 2.875]
			[-1.000, 2.875]
		]
	}
}

transform:
{

}

health:
{
	max: 880000.000
}

animated.renderer:
{
	sprite:
	{
		texture: skyhook.00.atlas
		size: [48, 64]
		frame: [1, 0]
	}
	z: -180.000
}

faction:
{
	
}

company:
{
	
}

storage:
{
	@inventory16:
	{
		type: storage
		flags: standalone, ignore_mass, no_auto_pickup, faction, vertical
		stack_size_multiplier: 2.000
		
		filter:
		{
			exclude: gas, large
		}
	}
}

// address:
// {
	
// }

skyhook:
{
	speed: 3.000
	length_max: 80.000
	length_current: 8.000			
	length_target: 8.000

	@sound.emitter:
	{
		file: conveyor.loop.01
		flags: start_muted
		volume: 1.000
		size: 0.500
	}
}

