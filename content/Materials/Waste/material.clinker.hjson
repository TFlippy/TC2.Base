{
	$version: "0.1.76.0"
	name: "Clinker"
	name_short: "Clinker"
	name_imperial: "Klinker"
	name_advanced: "Clinker"
	name_dumb: "Stone"
	description:
		'''
		Gravel-like byproduct from processing of aluminosilicate ores.
		Can be smashed into cement with a sledgehammer.
		'''
	
	tips: []
	
	icon:
	{
		texture: resource.clinker
		size: [16, 16]
		frame: [3, 0]
	}
	
	// Inventory material type.
	type: chalk
	flags: hard, granular, toxic, caustic, small, gravel, waste, solid, processed, impure, contaminated
	display_flags: none
	spawn_flags:
	{
		rem: pickup, allow_encumbered, show_notification
	}
	hints: materials, junk, construction, cheap, industrial, crappy, slow, clumsy
	
	// Ratio of the material volume to the total volume it occupies when stacked. A value of 1.0 means no empty space, while a value closer to 0.0 means a lot of empty space.
	packing_fraction: 0.000
	// General purity modifier.
	purity: 0.774
	// Mass of 1 unit in kg.
	mass_per_unit: 0.937
	
	// Maximum quantity (units) per stack.
	quantity_max: 500.000
	// Minimum spawnable quantity.
	spawn_quantity_threshold: 1.000
	// Preferred quantity snapping for recipes.
	snapping: 1.000
	// Preferred quantity snapping for inventories.
	snapping_pickup: 1.000
	
