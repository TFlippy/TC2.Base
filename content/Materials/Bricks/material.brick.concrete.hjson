{
	$version: "0.1.76.0"
	name: "Concrete Slabs"
	name_short: "Concrete"
	name_dumb: "Stone Brick"
	description:
		'''
		Standard ISO Concrete Masonry Unit (CMU) brick.

		Used as a building block of great empires, foundations and walls. 
		'''
	
	tips: []
	
	icon:
	{
		texture: resource.brick.concrete
		size: [16, 16]
		frame: [3, 0]
	}
	
	// Inventory material type.
	type: concrete
	flags: hard, granular, heavy, manufactured, ingot, solid, processed
	display_flags: sprite_stack_linear
	spawn_flags:
	{
		add: no_discard
	}
	hints: materials, construction, cheap, industrial, clumsy
	
	// Ratio of the material volume to the total volume it occupies when stacked. A value of 1.0 means no empty space, while a value closer to 0.0 means a lot of empty space.
	packing_fraction: 0.000
	// Mass of 1 unit in kg.
	mass_per_unit: 1.740
	
	// Volume occupied by a stack in m³.
	volume_per_stack: 0.9949
	
	// Maximum quantity (units) per stack.
	quantity_max: 500.000
	// Minimum spawnable quantity.
	spawn_quantity_threshold: 0.500
	// Preferred quantity snapping for recipes.
	snapping: 1.000
	// Preferred quantity snapping for inventories.
	snapping_pickup: 50.000
	
	form_type: brick
	prefab: resource.brick.concrete
	
	color_icon: "0xffffffff"
	color_item: "0xffffffff"
	color_dust: "0xffffffff"
	color_gib: "0xffffffff"
	
	centroid_default: [0.000, 0.250]
	colliders: []
	
	commodity:
	{
		flags: subsidized, standard
		categories: artificial, construction_materials, industrial, manufactured, recycled
		
		market_price: 7.600
		market_price_per_kg_auto: 4.367816
		market_supply_initial_ratio: 0.976
		market_supply_min: 0.120
		market_refill_rate_mult: 1.290
		
		industries_produce: manufacturing, low_tech, construction, colonization, engineering, architecture
		industries_consume: military, construction, labor, real_estate, colonization, engineering, architecture
		
		buildings_produce: factory, labor_camp, manufactory, quarry, brickworks
		
		categories_produce: industrial, urban, abandoned, ruined, fortified, excavated
		categories_consume: military, industrial, residential, urban, advanced, developing, fortified, modern, expansive
		
		geography_positive: excavated, wasteland, urban, underground
		geography_negative: damp, swamps, aerial, sky, mobile
		
		availability: 0.9741
	}
	
	// Residues from crafting/work.
	residues:
	{
		masonry:
		{
			h_material: scrap.rubble
			
			flags: none
			flags_product: waste
			
			yield: [0.640, 0.329]
		}
	}
	
	// Info regarding relations of other materials towards this material.
	related:
	{
		cement: ingredient, input
		scrap.concrete: ruined, mangled, similar, scrap
		scrap.rubble: ruined, mangled, dirty, waste, similar, impure, scrap, mixed
		sand: filler, ingredient
		gravel: filler, ingredient
		clinker: raw, impure
		betoniter: raw, ore, similar, natural
	}
}